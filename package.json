{
  "name": "devtools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pdf:sync-worker": "node -e \"const fs=require('fs');const p=require('pdfjs-dist/package.json');fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs');console.log('Synced pdf.worker.min.mjs from pdfjs-dist@'+p.version);\"",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "d1:create": "wrangler d1 create infyratools-production --config worker/wrangler.toml",
    "d1:migrate:local": "wrangler d1 migrations apply infyratools-production --local --config worker/wrangler.toml",
    "d1:migrate:remote": "wrangler d1 migrations apply infyratools-production --remote --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.40.0"
  }
}
