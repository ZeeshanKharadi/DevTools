# Used for canonical URLs, Open Graph, sitemap, and robots.
# Local default. For production builds set:
# NEXT_PUBLIC_SITE_URL=https://infyratools.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser API origin. Leave empty in production so the site calls same-origin
# /api/* (Cloudflare Worker route on infyratools.com). For local Worker:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_API_BASE_URL=

# Public card and dynamic QR URLs are built by the Worker (PUBLIC_BASE_URL),
# not by this Next.js env. Local Worker default: http://localhost:8787

